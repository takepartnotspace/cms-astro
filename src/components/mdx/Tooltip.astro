---
interface Props {
  text?: string;
  tooltipText?: string;
}

const { 
  text, 
  tooltipText = 'Gemeint sind alle Personen, die männlich sozialisiert wurden oder sich als Mann definieren.' 
} = Astro.props;
---

<span class="group relative inline-block cursor-help border-b border-dotted border-neutral-400 font-medium">
  {text}
  <span 
    class="pointer-events-none absolute bottom-full left-1/2 mb-2 hidden w-64 -translate-x-1/2 rounded-md bg-neutral-900 p-2.5 text-xs font-normal text-white shadow-xl group-hover:block z-50 leading-normal"
    role="tooltip"
  >
    {tooltipText}
    <span class="absolute top-full left-1/2 -ml-1 border-4 border-transparent border-t-neutral-900"></span>
  </span>
</span>