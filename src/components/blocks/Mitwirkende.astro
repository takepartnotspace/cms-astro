---
import { tinaField } from '@tinacms/astro/tina-field';

interface Supporter {
  name?: string;
  role?: string;
  image?: string;
}

interface Props {
  data: {
    supporters?: Supporter[];
  };
}

const { data } = Astro.props;
const supporters = data?.supporters ?? [];
---

<section class="pt-2 pb-12 md:pb-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 lg:gap-10">
      {supporters.map((person) => (
        <div 
          data-tina-field={tinaField(person)} 
          class="flex flex-col items-center text-center p-6 rounded-3xl border border-border/80 bg-neutral-800/50 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-violet-900/20 via-neutral-800/80 to-neutral-800 transition-all hover:border-violet-500/30 hover:bg-neutral-800/80 shadow-sm"
        >
          <div class="w-full max-w-[256px] aspect-square mb-6 overflow-hidden rounded-full border border-border shadow-md p-[7px] bg-neutral-900">
            {person.image ? (
              <img src={person.image} alt={person.name ?? ''} class="size-full rounded-full object-cover" />
            ) : (
              <div class="size-full flex items-center justify-center text-muted-foreground font-medium text-base rounded-full">Kein Bild</div>
            )}
          </div>
          {person.name && <h3 class="text-2xl font-bold tracking-tight text-foreground">{person.name}</h3>}
          {person.role && <p class="text-lg font-medium text-muted-foreground mt-2">{person.role}</p>}
        </div>
      ))}
    </div>
  </div>
</section>