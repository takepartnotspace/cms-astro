---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import AutoTooltipText from '../AutoTooltipText.astro';
import type { ContentBlock } from '../../lib/data';

interface Props { data: ContentBlock }

const { data } = Astro.props;

const customComponents = {
  ...mdxComponents,
  p: AutoTooltipText,
};
---
<Section>
	<div 
		class="mx-auto max-w-4xl prose prose-lg [&_h1]:!text-5xl [&_h1]:!font-semibold [&_h1]:!tracking-tight [&_h1]:!text-foreground [&_h1]:!leading-[1.05] [&_h1]:md:!text-6xl [&_h1]:xl:!text-[4.25rem] [&_h2]:!text-3xl [&_h2]:!font-semibold [&_h2]:!tracking-tight [&_h2]:!text-foreground [&_h2]:md:!text-4xl [&_h3]:!text-2xl [&_h3]:!font-semibold [&_h3]:!text-foreground [&_p]:!text-neutral-400 [&_p]:!text-lg [&_p]:!leading-snug [&_p]:md:!text-xl" 
		data-tina-field={tinaField(data, 'body')}
	>
		<TinaMarkdown content={data.body} components={customComponents} />
	</div>
</Section>