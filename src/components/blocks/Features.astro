---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import { mdxComponents } from '../mdx/components';
import Card from '../ui/Card.astro';
import CardHeader from '../ui/CardHeader.astro';
import CardContent from '../ui/CardContent.astro';
import Icon from '../ui/Icon.astro';
import type { FeaturesBlock } from '../../lib/data';

interface Props { data: FeaturesBlock }

const { data } = Astro.props;
const items = (data.items ?? []).filter(it => it !== null);
---
<Section>
	<div class="mx-auto max-w-7xl px-4">
		<div class="text-center">
			<h2 data-tina-field={tinaField(data, 'title')} class="text-balance text-4xl font-semibold sm:text-5xl lg:text-6xl tracking-tight">{data.title}</h2>
			<p data-tina-field={tinaField(data, 'description')} class="mt-4 text-2xl sm:text-3xl text-muted-foreground max-w-4xl mx-auto leading-snug">{data.description}</p>
		</div>
		
		<Card class="mx-auto mt-10 grid max-w-full divide-y overflow-hidden md:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-y-0 *:text-center">
			{items.map((item) => (
				<div data-tina-field={tinaField(item)} class="flex flex-col items-center px-4 py-3">
					<CardHeader class="p-0">
						<div class="relative mx-auto size-36">
							<div aria-hidden class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:24px_24px]"></div>
							<div aria-hidden class="absolute inset-0 bg-radial from-transparent to-background to-75%"></div>
							<div data-tina-field={tinaField(item, 'icon')} class="bg-background absolute inset-0 m-auto flex size-12 items-center justify-center border-l border-t shadow-sm">
								{item.icon && <Icon name={item.icon} class="size-12 text-foreground" />}
							</div>
						</div>
						<h3 data-tina-field={tinaField(item, 'title')} class="mt-3 text-2xl font-semibold leading-tight">{item.title}</h3>
					</CardHeader>
					{/* Zeilenabstand im Bodytext deutlich verringert: leading-tight */}
					<CardContent class="text-xl pt-3 pb-3 text-muted-foreground leading-tight">
						<div data-tina-field={tinaField(item, 'text')}>
							<TinaMarkdown content={item.text} components={mdxComponents} />
						</div>
					</CardContent>
				</div>
			))}
		</Card>
	</div>
</Section>