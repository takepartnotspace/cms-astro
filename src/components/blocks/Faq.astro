---
import { tinaField } from '@tinacms/astro/tina-field';

interface FaqItem {
  question?: string;
  answer?: string;
}

interface Props {
  data: {
    items?: FaqItem[];
  };
}

const { data } = Astro.props;
const items = data?.items ?? [];
---

<section class="pt-2 pb-12 md:pb-16">
  <div class="mx-auto max-w-4xl px-6">
    <div class="flex flex-col gap-4">
      {items.map((item) => (
        <details name="faq-accordion" data-tina-field={tinaField(item)} class="group rounded-2xl border border-border/80 bg-neutral-800/50 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-violet-900/20 via-neutral-800/80 to-neutral-800 transition-all hover:border-violet-500/30 hover:bg-neutral-800/80 [&[open]]:border-violet-500/40 [&[open]]:bg-neutral-800/90">
          <summary class="flex cursor-pointer items-center justify-between p-6 text-xl font-semibold tracking-tight text-foreground select-none">
            <span>{item.question}</span>
            <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </summary>
          {item.answer && (
            <div class="px-6 pb-6 pt-0 text-lg text-muted-foreground leading-relaxed">
              {item.answer}
            </div>
          )}
        </details>
      ))}
    </div>
  </div>
</section>