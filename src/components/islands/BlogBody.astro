---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog } from '../../lib/data';
import { mdxComponents } from '../mdx/components';

interface Props {
	data?: CmsBlog | null;
}

const { data } = Astro.props;
---

{data?.body && (
	<div class="blog-body-container text-left block">
		<div 
			data-tina-field={tinaField(data, 'body')} 
			class="prose prose-invert max-w-none text-lg md:text-xl leading-relaxed text-left"
		>
			<TinaMarkdown content={data.body} components={mdxComponents} />
		</div>
	</div>
)}

<style is:global>
  /* Verhindert zentrierte Block-Elemente im Fließtext */
  .blog-body-container,
  .blog-body-container *,
  .blog-body-container .prose p,
  .blog-body-container .prose div,
  .blog-body-container .prose h1,
  .blog-body-container .prose h2,
  .blog-body-container .prose h3,
  .blog-body-container .prose ul,
  .blog-body-container .prose ol,
  .blog-body-container .prose li {
    text-align: left !important;
    margin-left: 0 !important;
  }

  /* Ausrichtung für den Hauptcontainer selbst beibehalten */
  .blog-body-container {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Farben & Text-Kontrast */
  .blog-body-container .prose p,
  .blog-body-container .prose li,
  .blog-body-container .prose span {
    color: #a3a3a3 !important;
  }

  .blog-body-container .prose h1,
  .blog-body-container .prose h2,
  .blog-body-container .prose h3,
  .blog-body-container .prose h4,
  .blog-body-container .prose strong {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
</style>