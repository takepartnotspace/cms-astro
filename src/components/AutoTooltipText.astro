---
const defaultTooltip = 'Männlichkeit ist eine soziale und kulturelle Kategorie. Sie umfasst alle Personen, die sich als Mann definieren oder in der Gesellschaft als Männer positioniert sind.';

const rawHtml = await Astro.slots.render('default');

const processedHtml = rawHtml ? rawHtml.replace(/(?<!<[^>]*)\b(Männern|Männer|Mann)\b(?![^<]*>)/gi, (match) => {
  return `<span tabindex="0" class="tooltip-trigger group relative inline-block cursor-help border-b border-dotted border-neutral-400/50 leading-none pb-[1px] mb-0 font-medium focus:outline-none">${match}<span class="pointer-events-none absolute bottom-full left-1/2 mb-2 hidden w-64 -translate-x-1/2 rounded-md bg-neutral-900 p-2.5 text-xs font-normal text-white shadow-xl group-hover:block group-focus:block z-50 leading-normal" role="tooltip">${defaultTooltip}<span class="absolute top-full left-1/2 -ml-1 border-4 border-transparent border-t-neutral-900"></span></span></span>`;
}) : '';
---

<p><Fragment set:html={processedHtml} /></p>

<script>
  // Sorgt auf Mobilgeräten für verlässliches Antippen & Schließen
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const isTrigger = target.closest('.tooltip-trigger');
    
    // Schließt den Fokus auf allen Tooltips, wenn außerhalb getippt wird
    if (!isTrigger) {
      document.querySelectorAll('.tooltip-trigger').forEach((el) => {
        (el as HTMLElement).blur();
      });
    }
  });
</script>
