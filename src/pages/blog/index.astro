---
import Base from '../../layouts/Base.astro';
import { getConfig, listBlogs } from '../../lib/data';

const posts = await listBlogs();
const config = (await getConfig()).data?.config ?? null;
---

<Base
	title={config?.seo?.title ?? 'Blog'}
	description={config?.seo?.description ?? 'Welcome to my website!'}
>
	<main class="mx-auto max-w-6xl px-6 py-12">

		<!-- 3 Spalten in einer Reihe ab md -->
		<ul class="grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-3">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post._sys.filename}/`} class="group relative block overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-all hover:shadow-md">
						{/* Hohes Bildformat (aspect-[3/4]) */}
						{post.heroImage ? (
							<div class="relative aspect-[3/4] w-full overflow-hidden">
								<img 
									width={720} 
									height={960} 
									src={post.heroImage} 
									alt={post.title ?? ''} 
									class="size-full object-cover transition-transform duration-300 group-hover:scale-105" 
								/>
								{/* Overlay für Lesbarkeit */}
								<div class="absolute inset-0 bg-black/50 transition-colors group-hover:bg-black/40"></div>
							</div>
						) : (
							<div class="aspect-[3/4] w-full bg-neutral-900"></div>
						)}

						{/* Überlagerte Überschrift */}
						<div class="absolute inset-0 flex items-center justify-center p-6 text-center">
							<h2 class="text-balance text-2xl font-extrabold tracking-tight text-white drop-shadow-md group-hover:underline lg:text-3xl">
								{post.title}
							</h2>
						</div>
					</a>
				</li>
			))}
		</ul>
	</main>
</Base>