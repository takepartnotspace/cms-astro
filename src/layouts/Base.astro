---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import Noise from '../components/ui/Noise.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
---

<!doctype html>
<html lang="de" class="dark">
	<head>
		<!-- Font Preload: Verhindert das Hüpfen der Schrift beim Laden -->
		<link 
			rel="preload" 
			href="/fonts/SourceSans3-Regular.woff2" 
			as="font" 
			type="font/woff2" 
			crossorigin 
		/>

		<BaseHead title={title} description={description} image={image} />

		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	</head>
	<body>
		<Noise />

		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>

		<main class="md:pt-3">
			<slot />
		</main>

		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
	</body>
</html>
